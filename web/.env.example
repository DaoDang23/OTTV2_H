# ==============================================================================
# OTTV2 Frontend Environment Variables
# ==============================================================================
# URL của máy chủ Backend (Spring Boot qua Ngrok, Cloudflare Tunnel, hoặc VPS domain).
#
# - Khi deploy trên Vercel: Cấu hình biến này trong Settings -> Environment Variables.
#   Ví dụ: VITE_BACKEND_URL=https://revenue-princess-asleep.ngrok-free.dev
#
# - Khi chạy Dev tại Local (npm run dev): Để trống hoặc comment dòng này lại.
#   Vite dev-server sẽ tự động reverse proxy các request /api và /ws sang http://localhost:8080.
# ==============================================================================
VITE_BACKEND_URL=https://your-ngrok-domain.ngrok-free.dev
